# ── Robinhood Chain RPC ──────────────────────────────────────────────
# Public RPC — confirmed working over HTTP (chain ID 4663, real block
# numbers) in live testing. Free, no signup needed.
CHAIN_ID=4663
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com

# RPC_WS_URL is OPTIONAL. Leave it blank (as below) and the bot falls back
# to HTTP polling every POLL_INTERVAL_MS — no API key required, ~1s latency
# instead of instant push. This is the default and is fine for an
# alert-only bot (no gas bidding / no trading happens here anyway).
#
# The public endpoint's WebSocket (wss://rpc.mainnet.chain.robinhood.com)
# was tested and does NOT work — leave RPC_WS_URL blank rather than setting
# it to that. If you want true real-time push instead of polling, sign up
# for Alchemy (confirmed to support Robinhood Chain) and set both URLs to
# your Alchemy app's endpoints instead:
#   RPC_HTTP_URL=https://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>
#   RPC_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>
RPC_WS_URL=
POLL_INTERVAL_MS=1000

# Blockscout explorer API (used for funding-source lookback / backfill)
BLOCKSCOUT_API_BASE=https://robinhoodchain.blockscout.com/api/v2

# ── Optional: restrict pool-creation watcher to known factory addresses ──
# Leave empty to watch PairCreated/PoolCreated topic signatures chain-wide
# (recommended until you've confirmed the official factory addresses from
# https://docs.robinhood.com/chain/protocol-contracts).
UNISWAP_V2_FACTORY=
UNISWAP_V3_FACTORY=

# ── Detection engine tuning ───────────────────────────────────────────
# Minutes after pool creation during which an "initial buy" still counts
INITIAL_BUY_WINDOW_MINUTES=15
# % of pool reserves a single buy must represent to be flagged "large"
INITIAL_BUY_LARGE_PCT=15
# Minutes within which a liquidity removal after pool creation counts as a rug
RUG_WINDOW_MINUTES=180
# % of liquidity removed to count as a rug
RUG_REMOVAL_PCT=50
# Score (0-100) at/above which a wallet triggers a Telegram alert
ALERT_SCORE_THRESHOLD=60

# ── Wallet cluster / fan-out detection (for copy-trade signals) ──────────
# Flags "1 wallet funds N brand-new burner wallets" patterns — e.g. a
# multi-wallet sniper prepping accounts to buy a new memecoin, or a dev
# prepping fake buyer wallets. Once flagged, any purchase by a member
# wallet on a freshly-launched token fires an immediate "cluster wallet
# buying" alert — the signal to go copy-trade that wallet on Bloom etc.
#
# Minutes to look back when counting how many fresh wallets one source has funded
FANOUT_WINDOW_MINUTES=60
# Minimum distinct fresh wallets funded by the same source (within the window) to count as a cluster
FANOUT_MIN_WALLETS=3
# Minimum ETH value of a transfer to even consider it (filters out dust)
FANOUT_MIN_VALUE_ETH=0.0005

# ── Database / queue ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robinhood_tracker
REDIS_URL=redis://localhost:6379

# ── Telegram alerting ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web dashboard ─────────────────────────────────────────────────────
WEB_PORT=3000

LOG_LEVEL=info
