# ── Robinhood Chain RPC ──────────────────────────────────────────────
# Public RPC (rate-limited, fine for step 1/2 testing, NOT for 24/7 production):
#   https://rpc.mainnet.chain.robinhood.com
# Recommended production provider: Alchemy (confirmed live support for
# Robinhood Chain mainnet + testnet as of this writing). Sign up and create
# an app for "Robinhood Chain", then fill the URLs below.
# Verify current values yourself against https://docs.robinhood.com/chain/connecting
# before running against real funds/production alerts.
CHAIN_ID=4663
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WS_URL=wss://rpc.mainnet.chain.robinhood.com
# If using Alchemy instead, it looks roughly like:
# RPC_HTTP_URL=https://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>
# RPC_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/<API_KEY>

# Blockscout explorer API (used for funding-source lookback / backfill)
BLOCKSCOUT_API_BASE=https://robinhoodchain.blockscout.com/api/v2

# ── Optional: restrict pool-creation watcher to known factory addresses ──
# Leave empty to watch PairCreated/PoolCreated topic signatures chain-wide
# (recommended until you've confirmed the official factory addresses from
# https://docs.robinhood.com/chain/protocol-contracts).
UNISWAP_V2_FACTORY=
UNISWAP_V3_FACTORY=

# ── Detection engine tuning ───────────────────────────────────────────
# Minutes after pool creation during which an "initial buy" still counts
INITIAL_BUY_WINDOW_MINUTES=15
# % of pool reserves a single buy must represent to be flagged "large"
INITIAL_BUY_LARGE_PCT=15
# Minutes within which a liquidity removal after pool creation counts as a rug
RUG_WINDOW_MINUTES=180
# % of liquidity removed to count as a rug
RUG_REMOVAL_PCT=50
# Score (0-100) at/above which a wallet triggers a Telegram alert
ALERT_SCORE_THRESHOLD=60

# ── Database / queue ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robinhood_tracker
REDIS_URL=redis://localhost:6379

# ── Telegram alerting ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info
