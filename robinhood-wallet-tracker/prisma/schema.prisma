generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  address          String   @id
  firstSeenAt      DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  fundingSource    String?
  fundingTxHash    String?
  fundedAt         DateTime?
  latestRiskScore  Int      @default(0)
  priorDeployments Int      @default(0)
  priorRugs        Int      @default(0)
  notes            String?
  checked          Boolean   @default(false)
  checkedAt        DateTime?
  /// "I need to keep an eye on this one" — independent of `checked`
  /// (checked = reviewed/done; starred = important, keep watching).
  starred          Boolean   @default(false)
  starredAt        DateTime?
  /// "I've personally verified this is a dev wallet" — a confirmed-good
  /// source wallet worth following, gathered into its own "Ví Dev" section.
  /// Independent of checked/starred, and exempt from the checked-wallet
  /// trash auto-delete: a dev wallet is meant to stick around.
  isDevWallet      Boolean   @default(false)
  devWalletAt      DateTime?

  deployments   TokenDeployment[]
  scoreLogs     RiskScoreLog[]
  watchlistEntry WatchlistEntry?

  @@index([fundingSource])
  @@index([latestRiskScore])
  @@index([starred])
  @@index([isDevWallet])
}

model TokenDeployment {
  id             String   @id @default(cuid())
  tokenAddress   String   @unique
  deployerAddress String
  deployer       Wallet   @relation(fields: [deployerAddress], references: [address])
  deployTxHash   String
  deployedAt     DateTime
  looksLikeErc20 Boolean  @default(false)
  name           String?
  symbol         String?
  /// "I want to keep watching this token" — the inverse of Wallet.checked:
  /// here NOT saving is what starts the clock. A deployment left unsaved
  /// for 24h from deployedAt is permanently deleted (cascading its
  /// liquidity/swap/score events) so the list doesn't fill up with tokens
  /// nobody cared about.
  savedForWatch  Boolean  @default(false)
  savedAt        DateTime?

  liquidityEvents LiquidityEvent[]
  swapEvents      SwapEvent[]
  scoreLogs       RiskScoreLog[]

  @@index([deployerAddress])
  @@index([deployedAt])
  @@index([savedForWatch])
}

enum LiquidityEventType {
  POOL_CREATED
  INITIAL_BUY
  LIQUIDITY_REMOVED
}

model LiquidityEvent {
  id                String             @id @default(cuid())
  tokenDeploymentId String
  tokenDeployment   TokenDeployment    @relation(fields: [tokenDeploymentId], references: [id])
  type              LiquidityEventType
  dex               String?
  poolAddress       String?
  actorAddress      String
  txHash            String
  occurredAt        DateTime
  amountPct         Float?
  minutesAfterPool  Float?

  @@index([tokenDeploymentId])
  @@index([type])
}

model SwapEvent {
  id                String          @id @default(cuid())
  tokenDeploymentId String
  tokenDeployment   TokenDeployment @relation(fields: [tokenDeploymentId], references: [id])
  walletAddress     String
  txHash            String
  direction         String
  blockNumber       BigInt
  occurredAt        DateTime

  @@index([tokenDeploymentId])
  @@index([walletAddress])
}

model RiskScoreLog {
  id                String          @id @default(cuid())
  walletAddress     String
  wallet            Wallet          @relation(fields: [walletAddress], references: [address])
  tokenDeploymentId String
  tokenDeployment   TokenDeployment @relation(fields: [tokenDeploymentId], references: [id])
  score             Int
  breakdown         Json
  computedAt        DateTime        @default(now())

  @@index([walletAddress])
  @@index([score])
}

model WatchlistEntry {
  walletAddress String   @id
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])
  addedAt       DateTime @default(now())
  reason        String
  alertsEnabled Boolean  @default(true)
}

/// Every native-ETH transfer worth noting (above FANOUT_MIN_VALUE_ETH) into a
/// wallet that had never sent a transaction before — the raw material for
/// detecting "1 funder -> many brand-new sub-wallets" fan-out patterns.
model FundingTransfer {
  id               String   @id @default(cuid())
  fromAddress      String
  toAddress        String
  txHash           String
  valueWei         String
  occurredAt       DateTime
  toWasFreshWallet Boolean

  @@index([fromAddress, occurredAt])
  @@index([toAddress])
}

/// A funding source that has fanned out to >= FANOUT_MIN_WALLETS wallets
/// within one tight burst (see FANOUT_MAX_GAP_MINUTES). Every wallet
/// sourceAddress has ever funded is shown as a cluster member for
/// buyer-matching, not just the ones in the burst that tripped the
/// threshold.
model FundingCluster {
  id              String    @id @default(cuid())
  sourceAddress   String    @unique
  firstDetectedAt DateTime  @default(now())
  lastUpdatedAt   DateTime  @updatedAt
  walletCount     Int
  /// Why this source tripped detection: "fresh" (fanned out to brand-new
  /// nonce-0 wallets), "amount" (fanned the same amount out to several
  /// wallets close together in time, regardless of freshness — catches an
  /// exchange/bridge wallet feeding several source wallets one person
  /// controls), or "fresh+amount" (both signals fired).
  matchType       String    @default("fresh")
  /// "This whole cluster needs watching" — separate from starring individual
  /// member wallets; starred clusters sort to the top of the cluster list.
  starred         Boolean   @default(false)
  starredAt       DateTime?

  @@index([sourceAddress])
  @@index([starred])
}
